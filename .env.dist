# Copy to .env and adjust. The .env file is gitignored.
# Variables can also be set as host environment variables.
# They configure both the Docker containers (docker-compose.yaml) and the test suite.

# MySQL host port (default: 35306). Change if it collides with another project.
#ORISAI_DBAUDIT_MYSQL_PORT=35306
# MySQL image version (default: 8.0). Supported: 8.0, 8.4, 9.4.
# Switching versions on an existing data volume may fail; run `make docker-stop` and remove the volume first.
#ORISAI_DBAUDIT_MYSQL_VERSION=8.0

# MariaDB host port (default: 35307). Change if it collides with another project.
#ORISAI_DBAUDIT_MARIADB_PORT=35307
# MariaDB image version (default: 11.4). Supported: 10.11, 11.4, 12.0.
# Switching versions on an existing data volume may fail; run `make docker-stop` and remove the volume first.
#ORISAI_DBAUDIT_MARIADB_VERSION=11.4
